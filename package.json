{
  "name": "pokemon-go-information",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data:pokemon": "node scripts/generate-pokemon-data.mjs",
    "data:game": "node scripts/generate-game-data.mjs",
    "data:pvp": "node scripts/generate-pvp-rankings.mjs",
    "data:rocket-dialogues": "node scripts/generate-rocket-dialogues.mjs",
    "data:pokefuta": "node scripts/generate-pokefuta-data.mjs",
    "data:pokefuta:full": "node scripts/generate-pokefuta-data.mjs --full",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:assets": "node scripts/verify-type-assets.mjs",
    "test:icons": "node scripts/verify-icon-assets.mjs",
    "test": "node scripts/verify-icon-assets.mjs && node scripts/verify-viewport.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "cheerio": "^1.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
